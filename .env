# ──────────────────────────────────────────────────────
# IoT Dashboard — Environment Configuration
# ──────────────────────────────────────────────────────

# ── Grafana ────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=adminpassword

# ── MQTT Broker ────────────────────────────────────────
# Alamat MQTT broker yang digunakan Telegraf untuk subscribe
# MQTT_BROKER_HOST=10.109.25.97
MQTT_BROKER_HOST=10.109.25.97
MQTT_BROKER_PORT=1883

# ── API Behavior & Personal API Platform (Main API) ────────────────
# Berapa menit terakhir untuk menganggap device sebagai "Online"
ONLINE_THRESHOLD_MINUTES=5
IOT_API_PORT=8002
IOT_WEB_PORT=8088
PAP_API_URL=http://192.168.25.101:8000
PAP_API_KEY=pap_key_iot_dashboard_default_secret_key_2026
